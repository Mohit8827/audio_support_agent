# Copy this file to .env and adjust local runtime settings.

# Preferred local stack: Whisper + Ollama + Edge TTS.
# Required local tools:
# - ffmpeg available on PATH for Whisper
# - Ollama running locally with the configured model pulled

# Whisper STT
WHISPER_MODEL=base
WHISPER_LANGUAGE=
WHISPER_DEVICE=
MAX_AUDIO_UPLOAD_BYTES=10485760

# Ollama LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_VALIDATE_CONNECTION=true
MAX_TEXT_INPUT_CHARS=2000
RAG_N_RESULTS=3

# Edge TTS
EDGE_TTS_VOICE=en-US-AriaNeural
EDGE_TTS_OUTPUT_FORMAT=audio-24khz-48kbitrate-mono-mp3
MAX_TTS_TEXT_CHARS=4000

# Optional service API keys if you choose to extend this project later
# STT Options:
DEEPGRAM_API_KEY=your_deepgram_api_key_here         # https://console.deepgram.com/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here     # https://www.assemblyai.com/

# LLM Options:
OPENAI_API_KEY=your_openai_api_key_here             # https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here       # https://console.anthropic.com/
GOOGLE_API_KEY=your_google_api_key_here             # https://cloud.google.com/

# TTS Options:
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here     # https://elevenlabs.io/
AZURE_SPEECH_KEY=your_azure_speech_key_here         # https://azure.microsoft.com/
AZURE_SPEECH_REGION=your_azure_region

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Logging Configuration
LOG_LEVEL=INFO
